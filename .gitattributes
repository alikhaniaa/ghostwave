# Normalize source text; preserve raster art, audio, and fonts byte-for-byte.
* text=auto eol=lf

*.cpp       text
*.hpp       text
*.fs        text
*.json      text
*.md        text
*.cfg       text
*.import    text

*.sh        text eol=lf
*.ps1       text eol=crlf

*.png  binary
*.jpg  binary
*.exr  binary
*.hdr  binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.glb  binary
*.ttf  binary
*.otf  binary
*.res  binary
*.scn  binary
